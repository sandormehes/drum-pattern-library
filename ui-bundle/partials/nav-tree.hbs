<ul class="nav-tree">
{{#each items}}
  <li>
    {{#if items}}
      <details class="nav-branch">
        <summary>{{content}}</summary>
        {{#if url}}<a class="nav-tree__overview" href="{{relativize url}}">All {{content}}</a>{{/if}}
        {{> nav-tree items=items}}
      </details>
    {{else}}
      {{#if url}}
        <a href="{{relativize url}}" {{#if (isCurrent url)}}aria-current="page"{{/if}}>{{content}}</a>
      {{else}}
        <span class="nav-tree__label">{{content}}</span>
      {{/if}}
    {{/if}}
  </li>
{{/each}}
</ul>
